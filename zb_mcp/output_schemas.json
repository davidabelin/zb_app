    "RuntimeStatusEventResponse": {
      "type": "object",
      "description": "Acknowledgement for one recorded runtime status event.",
      "required": [
        "status",
        "message",
        "stage",
        "detail"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "success"
          ]
        },
        "message": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      }
    }
  }
}

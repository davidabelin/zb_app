      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "success"
          ]
        },
        "requested_count": {
          "type": "integer",
          "description": "Effective requested count after validation."
        },
        "sampled_count": {
          "type": "integer",
          "description": "Number of unique compact rows returned."
        },
        "available_count": {
          "type": "integer",
          "description": "Number of non-excluded rows available for sampling."
        },
        "records": {
          "type": "array",
          "description": "Compact random sample rows; these do not contain transcript messages.",
          "items": {
            "$ref": "#/components/schemas/ReviewListItem"
          }
        }
      }
    },

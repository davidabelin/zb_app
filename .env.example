# Local development defaults (do not use production secrets here).
GOOGLE_CLOUD_PROJECT=zenbot-434517

# Secret Manager key names
OPENAI_API_KEY_SECRET_NAME=zb-openai-api-key
FLASK_SECRET_KEY_SECRET_NAME=zb-flask-secret-key
ACTION_API_TOKEN_SECRET_NAME=zb-action-api-token

# Optional local fallback values
OPENAI_API_KEY=
FLASK_SECRET_KEY=dev-insecure-key-change-me
ACTION_API_TOKEN=

# Runtime options
STREAMING_ENABLED=true
ZB_API_STRICT_AUTH=true
SESSION_COOKIE_SECURE=false
WEB_APP_ORIGIN=https://zenbot-434517.uw.r.appspot.com

# OpenAI runtime defaults
OPENAI_LIVE_MODEL=gpt-5.4-mini
OPENAI_JUDGE_MODEL=gpt-5.4
OPENAI_POST_TRAINING_MODEL=gpt-4.1
OPENAI_REASONING_EFFORT=minimal
OPENAI_REASONING_SUMMARY=auto
OPENAI_PROMPT_CACHE_PREFIX=zenbot-v3
OPENAI_PROMPT_CACHE_RETENTION=24h
OPENAI_ENABLE_FUNCTION_TOOLS=true
OPENAI_ENABLE_FILE_SEARCH=false
OPENAI_ENABLE_WEB_SEARCH=false
OPENAI_ENABLE_BACKGROUND_CRITIC=false
OPENAI_VECTOR_STORE_IDS=

# Hot session state
HOT_STATE_BACKEND=
REDIS_URL=
SESSION_TTL_SECONDS=86400
